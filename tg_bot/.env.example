# ==========================================
# MADAD TA'LIM — Telegram Bot Sozlamalari
# ==========================================

# Telegram Bot Token (Telegram @BotFather dan olinadi)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Bot Adminlarining Telegram ID lari (vergul bilan ajratilgan)
# Telegram ID ni @userinfobot orqali bilish mumkin
ADMIN_IDS=123456789,987654321

# Admin panelga kirish paroli (Dastlabki standart parol)
ADMIN_PASSWORD=admin123

# Vaqt mintaqasi (O'zbekiston uchun Asia/Tashkent)
TZ=Asia/Tashkent

# Avtomatik dars jadvalini yuborish vaqti (HH:mm formatda)
DEFAULT_SEND_TIME=06:00

# SQLite ma'lumotlar bazasi yo'li
DB_PATH=./data/bot.sqlite

# Web server porti (Mini App va REST API uchun)
PORT=3000

# Telegram Web App URL (Mini App manzili: masalan https://your-domain.com yoki ngrok/localtunnel)
WEB_APP_URL=

# Log darajasi (info, debug, warn, error)
LOG_LEVEL=info
